generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String     @id @default(cuid())
  googleId  String     @unique
  name      String
  email     String     @unique
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  senders   Sender[]
  campaigns Campaign[]
}

model Sender {
  id        String    @id @default(cuid())
  userId    String
  email     String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id          String         @id @default(cuid())
  userId      String
  subject     String
  body        String
  startTime   DateTime
  delayMs     Int
  hourlyLimit Int
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails      Email[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Email {
  id                  String      @id @default(cuid())
  campaignId          String
  senderId            String
  recipient           String
  subject             String
  body                String
  scheduledAt         DateTime
  status              EmailStatus  @default(SCHEDULED)
  bullJobId           String?     @unique
  idempotencyKey      String      @unique
  attempts            Int         @default(0)
  sentAt              DateTime?
  failedAt            DateTime?
  errorMessage        String?
  previewUrl          String?
  processingStartedAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  campaign            Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender              Sender      @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([campaignId, status])
  @@index([senderId, status])
  @@index([recipient])
}
